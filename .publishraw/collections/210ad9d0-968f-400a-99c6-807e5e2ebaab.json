{
  "id": "210ad9d0-968f-400a-99c6-807e5e2ebaab",
  "formatVersion": 1,
  "source": {
    "siteRoot": ".",
    "include": [
      "content/notes/*.md"
    ],
    "exclude": [
      ".publishraw/**"
    ],
    "format": "markdown-yaml-v1",
    "parserId": "yaml+marked",
    "parserVersion": "2.9.0+18.0.12"
  },
  "schema": {
    "validatorPath": ".publishraw/runtime/react-vite/0.0.1/validate.mjs",
    "fields": [
      {
        "path": "/title",
        "type": "string",
        "required": true
      },
      {
        "path": "/order",
        "type": "integer",
        "required": true
      }
    ]
  },
  "identity": {
    "strategy": "file-path",
    "caseSensitivity": "sensitive",
    "filenameRule": "vite-routerless:markdown-stem",
    "urlRule": "vite-routerless:fragment"
  },
  "semantics": {
    "title": "/title",
    "body": "markdown:body"
  },
  "rendering": {
    "adapterId": "react-vite",
    "adapterVersion": "0.0.1",
    "sources": [
      "src/main.jsx"
    ],
    "listRoutes": [
      "/"
    ],
    "consumers": [
      "FieldNotes"
    ],
    "buildHook": "npm run build",
    "devHook": "npm run dev",
    "generatedOutputRoot": "src/generated"
  },
  "layouts": {
    "default": "note",
    "variants": [
      {
        "id": "note",
        "inputs": [
          "title",
          "body"
        ],
        "placements": [
          "body"
        ],
        "renderer": "FieldNotes",
        "crop": "none"
      }
    ],
    "hints": [],
    "responsive": "Existing src/style.css"
  },
  "checks": [
    {
      "id": "build",
      "cwd": ".",
      "argv": [
        "npm",
        "run",
        "build"
      ],
      "timeoutSeconds": 1800,
      "required": true,
      "evidenceKind": "build"
    }
  ],
