{
  "id": "becc746e-4a24-4e54-a346-7fba3cf08767",
  "formatVersion": 1,
  "source": {
    "siteRoot": "site",
    "include": [
      "content/notes/*.md"
    ],
    "exclude": [
      ".publishraw/**"
    ],
    "format": "markdown-yaml-v1",
    "parserId": "yaml+marked",
    "parserVersion": "2.9.0+18.0.12"
  },
  "schema": {
    "validatorPath": ".publishraw/runtime/react-vite/0.0.1/validate.mjs",
    "fields": [
      {
        "path": "/title",
        "type": "string",
        "required": true
      },
      {
        "path": "/order",
        "type": "integer",
        "required": true
      }
    ]
  },
  "identity": {
    "strategy": "file-path",
    "caseSensitivity": "sensitive",
    "filenameRule": "vite-routerless:markdown-stem",
    "urlRule": "vite-routerless:fragment"
  },
  "semantics": {
    "title": "/title",
    "body": "markdown:body"
  },
  "rendering": {
    "adapterId": "react-vite",
    "adapterVersion": "0.0.1",
    "sources": [
      "site/src/main.jsx"
    ],
    "listRoutes": [
      "/"
    ],
    "consumers": [
      "FieldNotes"
    ],
    "buildHook": "npm run build",
    "devHook": "npm run dev",
    "generatedOutputRoot": "site/src/generated"
  },
  "layouts": {
    "default": "note",
    "variants": [
      {
        "id": "note",
        "inputs": [
          "title",
          "body"
        ],
        "placements": [
          "body"
        ],
        "renderer": "FieldNotes",
        "crop": "none"
      }
    ],
    "hints": [],
    "responsive": "Existing src/style.css"
  },
  "checks": [
    {
      "id": "build",
      "cwd": "site",
      "argv": [
        "npm",
        "run",
        "build"
      ],
      "timeoutSeconds": 1800,
      "required": true,
      "evidenceKind": "build"
    }
  ],
  "observedSources": [
